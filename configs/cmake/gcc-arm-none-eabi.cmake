cmake_minimum_required(VERSION 3.23)
include("${CMAKE_CURRENT_LIST_DIR}/load_board.cmake")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PNX_BOARD)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_C_COMPILER arm-none-eabi-gcc)
set(CMAKE_CXX_COMPILER arm-none-eabi-g++)
set(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
set(CMAKE_OBJCOPY arm-none-eabi-objcopy)
set(CMAKE_OBJDUMP arm-none-eabi-objdump)
set(CMAKE_READELF arm-none-eabi-readelf)
set(CMAKE_SIZE arm-none-eabi-size)
foreach(language IN ITEMS C CXX ASM)
    set(CMAKE_EXECUTABLE_SUFFIX_${language} ".elf")
endforeach()
set(CMAKE_C_FLAGS_INIT "${PNX_TARGET_FLAGS} -Wall -fdata-sections -ffunction-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-rtti -fno-exceptions -fno-threadsafe-statics")
set(CMAKE_ASM_FLAGS_INIT "${PNX_TARGET_FLAGS} -x assembler-with-cpp -MMD -MP")
foreach(language IN ITEMS C CXX)
    set(CMAKE_${language}_FLAGS_DEBUG_INIT "-O0 -g3")
    set(CMAKE_${language}_FLAGS_RELEASE "-Os -g0 -DNDEBUG" CACHE STRING "Release ${language} flags")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT
    "${PNX_TARGET_FLAGS} -T\"${PNX_BOARD_LINKER_SCRIPT}\" --specs=nano.specs -Wl,-Map=pnx_embedded.map -Wl,--gc-sections -Wl,--print-memory-usage")
set(TOOLCHAIN_LINK_LIBRARIES m)
