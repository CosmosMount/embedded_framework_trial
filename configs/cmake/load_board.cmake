# Resolve a config profile without reading CubeMX-generated files.
# Shared by firmware, toolchain, standalone generation and editor export.
get_filename_component(PNX_CONFIG_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(PNX_BOARD "h723_dmmc02" CACHE STRING "Selected PnX config profile")
file(GLOB profiles RELATIVE "${PNX_CONFIG_DIR}/boards" "${PNX_CONFIG_DIR}/boards/*/board.cmake")
set(PNX_AVAILABLE_BOARDS)
foreach(profile IN LISTS profiles)
    get_filename_component(name "${profile}" DIRECTORY)
    list(APPEND PNX_AVAILABLE_BOARDS "${name}")
endforeach()
set_property(CACHE PNX_BOARD PROPERTY STRINGS ${PNX_AVAILABLE_BOARDS})
if(NOT PNX_BOARD IN_LIST PNX_AVAILABLE_BOARDS)
    message(FATAL_ERROR "Unknown PNX_BOARD='${PNX_BOARD}'. Choose one of: ${PNX_AVAILABLE_BOARDS}")
endif()

set(PNX_BOARD_CONFIG_DIR "${PNX_CONFIG_DIR}/boards/${PNX_BOARD}")
unset(PNX_BOARD_FAMILY)
unset(PNX_TARGET_FLAGS)
unset(PNX_BOARD_OPENOCD_TARGET)
include("${PNX_BOARD_CONFIG_DIR}/board.cmake")
foreach(setting IN ITEMS PNX_BOARD_FAMILY PNX_TARGET_FLAGS PNX_BOARD_OPENOCD_TARGET)
    if(NOT DEFINED ${setting} OR "${${setting}}" STREQUAL "")
        message(FATAL_ERROR "${PNX_BOARD_CONFIG_DIR}/board.cmake must define ${setting}")
    endif()
endforeach()
set(PNX_BOARD_IOC "${PNX_BOARD_CONFIG_DIR}/${PNX_BOARD}.ioc")
set(PNX_BOARD_CONFIG "${PNX_BOARD_CONFIG_DIR}/board.json")
set(PNX_BOARD_PARAMS "${PNX_BOARD_CONFIG_DIR}/params.json")
set(PNX_BOARD_ROBOT_CONFIG "${PNX_BOARD_CONFIG_DIR}/robot.json")
set(PNX_BOARD_LINKER_SCRIPT "${PNX_BOARD_CONFIG_DIR}/memory.ld")
foreach(input IN ITEMS PNX_BOARD_IOC PNX_BOARD_CONFIG PNX_BOARD_PARAMS
        PNX_BOARD_ROBOT_CONFIG PNX_BOARD_LINKER_SCRIPT)
    if(NOT EXISTS "${${input}}")
        message(FATAL_ERROR "Incomplete config '${PNX_BOARD}': ${input} missing: ${${input}}")
    endif()
endforeach()
file(READ "${PNX_BOARD_CONFIG}" board_identity)
string(JSON config_name GET "${board_identity}" name)
string(JSON config_family GET "${board_identity}" mcu_family)
if(NOT config_name STREQUAL PNX_BOARD OR NOT config_family STREQUAL PNX_BOARD_FAMILY)
    message(FATAL_ERROR "${PNX_BOARD_CONFIG}: name/mcu_family must match the selected profile and board.cmake")
endif()
