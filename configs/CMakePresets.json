{
  "version": 4,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/configs/cmake/gcc-arm-none-eabi.cmake"
    },
    {
      "name": "h723-debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_BOARD": "h723_dmmc02"
      }
    },
    {
      "name": "h723-release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_BOARD": "h723_dmmc02"
      }
    },
    {
      "name": "f407-debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_BOARD": "f407_cboard"
      }
    },
    {
      "name": "f407-release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_BOARD": "f407_cboard"
      }
    },
    {
      "name": "target-test",
      "hidden": true,
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-Os -g -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-Os -g -DNDEBUG",
        "CMAKE_PROJECT_pnx_embedded_INCLUDE": "${sourceDir}/tests/target/inject.cmake"
      }
    },
    {
      "name": "h723-core-test",
      "inherits": "target-test",
      "cacheVariables": {
        "PNX_BOARD": "h723_dmmc02",
        "PNX_TARGET_TEST_SOURCE": "${sourceDir}/tests/target/core.cpp"
      }
    },
    {
      "name": "f407-core-test",
      "inherits": "target-test",
      "cacheVariables": {
        "PNX_BOARD": "f407_cboard",
        "PNX_TARGET_TEST_SOURCE": "${sourceDir}/tests/target/core.cpp"
      }
    },
    {
      "name": "h723-usart-test",
      "inherits": "target-test",
      "cacheVariables": {
        "PNX_BOARD": "h723_dmmc02",
        "PNX_TARGET_TEST_SOURCE": "${sourceDir}/tests/target/usart.cpp"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "h723-debug",
      "configurePreset": "h723-debug"
    },
    {
      "name": "h723-release",
      "configurePreset": "h723-release"
    },
    {
      "name": "f407-debug",
      "configurePreset": "f407-debug"
    },
    {
      "name": "f407-release",
      "configurePreset": "f407-release"
    },
    {
      "name": "h723-core-test",
      "configurePreset": "h723-core-test"
    },
    {
      "name": "f407-core-test",
      "configurePreset": "f407-core-test"
    },
    {
      "name": "h723-usart-test",
      "configurePreset": "h723-usart-test"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  }
}
