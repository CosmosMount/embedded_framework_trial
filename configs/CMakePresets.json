{
  "version": 4,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/configs/cmake/gcc-arm-none-eabi.cmake"
    },
    {
      "name": "h723-debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_BOARD": "h723_dmmc02"
      }
    },
    {
      "name": "h723-release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_BOARD": "h723_dmmc02"
      }
    },
    {
      "name": "f407-debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_BOARD": "f407_cboard"
      }
    },
    {
      "name": "f407-release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_BOARD": "f407_cboard"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "h723-debug",
      "configurePreset": "h723-debug"
    },
    {
      "name": "h723-release",
      "configurePreset": "h723-release"
    },
    {
      "name": "f407-debug",
      "configurePreset": "f407-debug"
    },
    {
      "name": "f407-release",
      "configurePreset": "f407-release"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  }
}
